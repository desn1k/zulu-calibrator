# Copy to .env and fill in: cp .env.example .env
# .env holds secrets and is never committed.

# Domain name of the site. Its DNS A-record must point to this server's IP.
# Caddy obtains the HTTPS certificate for it automatically.
DOMAIN=calib.example.org

# Optional: contact email for the Let's Encrypt account (expiry and problem notices).
# Leave empty to register without an email.
ACME_EMAIL=

# Version tag of the locally built image. Always an explicit version, never "latest".
IMAGE_TAG=v0.1.0-rc1

# Secret for signing sessions and CSRF tokens. Generate once and keep it private:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database connection string. Inside Docker it is fixed to sqlite:////data/app.db
# by docker-compose.yml; this value is used only when running the app outside Docker.
DATABASE_URL=sqlite:///./data/app.db

# Web server log level: critical | error | warning | info | debug
LOG_LEVEL=info
